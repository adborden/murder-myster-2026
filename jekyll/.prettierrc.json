{
  "plugins": ["@shopify/prettier-plugin-liquid"],
  "overrides": [
    {
      "files": ["_includes/**/*.html", "_layouts/**/*.html"],
      "options": {
        "parser": "liquid-html"
      }
    },
    {
      "files": ["_posts/**/*.{md,markdown}"],
      "options": {
        "parser": "liquid"
      }
    }
  ]
}
